# ============================================================
#  Plantilla de configuracion del orquestador (COPIAR a .env)
#  NO subir el .env real a git. Mantener fuera de carpetas compartidas.
# ============================================================

# --- SQL Server (BD_FUSIONCORE) ---
SQL_SERVER=NOMBRE_O_IP_DEL_SERVIDOR_SQL
SQL_DATABASE=BD_FUSIONCORE
# true = autenticacion Windows (recomendado, sin clave). false = usuario/clave SQL
SQL_INTEGRATED_SECURITY=true
SQL_USER=
SQL_PASS=

# --- SAP ---
SAP_MANDANTE=300
# Opcion A (recomendada): dejar vacios y loguear a mano (modo atendido)
# Opcion B: poner credenciales aqui (texto plano, menos seguro)
SAP_USER=
SAP_PASS=
# Opcion C (mas segura para desatendido): ruta a un .cred.xml cifrado con DPAPI
# Si esta seteada, tiene prioridad sobre SAP_USER/SAP_PASS
SAP_CRED_XML=

# --- API RMS (PostPO) ---
POSTPO_URL=http://10.9.1.224:8080/WSAPIWeb/RCSDocServices.svc/PO/PostPO
POSTPO_TOKEN=

# --- Operacion ---
LOTE_WPMA=1000
DRY_RUN=true
