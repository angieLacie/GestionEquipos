# Copia este archivo a .env.local y ajusta la URL según dónde corras la app.
# El valor activo es EXPO_PUBLIC_API_URL (Expo lo embebe en dev/build).
# El backend Nova debe estar corriendo en :5109.

# Emulador Android (Android Studio) — 10.0.2.2 es el alias del host (tu PC):
EXPO_PUBLIC_API_URL=http://10.0.2.2:5109

# Simulador iOS (solo Mac) — comparte la red del Mac:
# EXPO_PUBLIC_API_URL=http://localhost:5109

# Teléfono físico (Expo Go) — usa la IP LAN de tu PC en la misma WiFi:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5109

# Producción — URL pública de la API desplegada (pendiente de definir):
# EXPO_PUBLIC_API_URL=https://api.tudominio.com
